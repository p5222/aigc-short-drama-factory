{
  "name": "@aifilm/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "tsx --test src/**/*.test.ts",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:push": "prisma db push --schema prisma/schema.prisma",
    "db:push:deploy": "prisma db push --schema prisma/schema.prisma --accept-data-loss",
    "db:studio": "prisma studio --schema prisma/schema.prisma"
  },
  "dependencies": {
    "bullmq": "^5.79.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ioredis": "^5.11.1",
    "sharp": "^0.35.2",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@aifilm/shared": "workspace:*",
    "@prisma/client": "^6.19.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "prisma": "^6.19.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
