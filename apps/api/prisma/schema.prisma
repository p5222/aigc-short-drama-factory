generator client {
  provider = "prisma-client-js"
}

model AdminAuditLog {
  id          String   @id
  actorId     String
  actorRole   String
  action      String
  target      String
  details     Json     @default("{}")
  ipAddress   String?
  status      String   @default("started")
  statusCode  Int?
  createdAt   DateTime @default(now())
  completedAt DateTime?

  @@index([createdAt, id])
  @@index([actorId, createdAt])
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id
  name         String
  email        String?       @unique
  phone        String?       @unique
  avatarUrl    String?
  passwordHash String?
  role         String        @default("creator")
  status       String        @default("active")
  projects     Project[]
  credit       CreditAccount?
  transactions CreditTransaction[]
  fundingLots  CreditFundingLot[]
  tasks        GenerationTask[]
  creationRequests CreationRequest[]
  redemptions  RedeemRedemption[]
  sessions     AuthSession[]
  orders       RechargeOrder[]
  membership   UserMembership?
  invoices     Invoice[]
  exportJobs   ExportJob[]
  analyticsEvents AnalyticsEvent[]
  feedbacks    UserFeedback[]
  showcaseWorks ShowcaseWork[]
  creatorPreference CreatorPreference?
  supportTickets SupportTicket[]
  supportRequests SupportTicketRequest[] @relation("SupportRequestActor")
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}
model AuthSession {
  id         String    @id
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  lastUsedAt DateTime  @default(now())
  revokedAt  DateTime?
createdAt DateTime @default(now())
  @@index([userId])
  @@index([userId, createdAt, id])
  @@index([expiresAt])
}

model Project {
  id           String           @id
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  type         String
  intro        String           @default("")
  sourceType   String
  artStyle     String
  videoRatio   String
  textProvider  String?
  textModel     String?
  imageProvider String?
  imageModel    String?
  imageSize     String?
  imageQuality  String?
  videoProvider String?
  videoModel    String?
  status       String
  episodes     Int             @default(1)
  segmentProfile String        @default("jimeng_15s")
  episodeDurationSeconds Int   @default(180)
  sourceCharactersPerEpisode Int @default(20000)
  allowExpansion Boolean       @default(false)
  activeStoryboardVersion Int  @default(1)
  storyboards  Int             @default(0)
  characters   Int             @default(0)
  imageAssets  Int             @default(0)
  videoClips   Int             @default(0)
  creditsSpent Int             @default(0)
  scripts      ScriptDraft[]
  characterSet Character[]
  assets       Asset[]
  shots        Storyboard[]
  tasks        GenerationTask[]
  transactions CreditTransaction[]
  exportJobs   ExportJob[]
  deliveryEdits DeliveryEdit[]
  qualityReports QualityReport[]
  evaluationRuns EvaluationRun[]
  feedbacks    UserFeedback[]
  analyticsEvents AnalyticsEvent[]
  showcaseWorks ShowcaseWork[]
  productionEpisodes ProductionEpisode[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  @@index([userId])
}

model DeliveryEdit {
  id        String   @id
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  episodeNo Int
  revision  Int      @default(1)
  clips     Json
  updatedAt DateTime @updatedAt
  @@unique([projectId, episodeNo])
}

model ScriptDraft {
  id        String   @id
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  content   String
  synopsis  String
  version   Int      @default(1)
  promptSnapshot Json @default("{}")
  createdAt DateTime @default(now())
  @@index([projectId])
}

model Character {
  id               String   @id
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name             String
  identity         String
  appearance       String
  costume          String
  personality      String
  prompt           String
  negativePrompt   String
  referenceAssetId String?
  voiceId          String?
  seed             Int?
  consistencyLevel String   @default("medium")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  @@index([projectId])
}

model Asset {
  id                 String   @id
  projectId          String
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type               String
  name               String
  description        String
  prompt             String
  referenceUrl       String?
  status             String
  relatedCharacterId String?
  reusedFromAssetId  String?
  reusedFromUpdatedAt DateTime?
  qualityReports     QualityReport[]
  feedbacks          UserFeedback[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  @@index([projectId])
}

model ShowcaseWork {
  id             String    @id
  creatorId      String?
  creator        User?     @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  projectId      String?
  project        Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  sourceAssetId  String?
  title          String
  description    String    @default("")
  category       String    @default("AI短剧")
  authorName     String    @default("")
  coverUrl       String
  videoUrl       String
  durationLabel  String    @default("00:00")
  status         String    @default("pending")
  featured       Boolean   @default(false)
  sortOrder      Int       @default(0)
  reviewNote     String    @default("")
  submittedAt    DateTime?
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, featured, sortOrder])
  @@index([creatorId, createdAt])
  @@index([projectId])
}

model Storyboard {
  id                String   @id
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  episodeNo         Int
  sceneNo           Int
  shotNo            Int
  duration          Int
  shotSize          String
  cameraAngle       String
  cameraMovement    String
  characters        String[]
  scene             String
  pictureDesc       String
  action            String   @default("")
  orientation       String   @default("")
  spatialRelation   String   @default("")
  emotion           String   @default("")
  dialogue          String
  voiceOver         String
  environmentSound  String
  soundEffect       String
  imagePrompt       String
  videoPrompt       String
  referenceAssetIds String[]
  status            String
  segmentProfile    String?
  sequenceNo        Int?
  startSeconds      Float?
  endSeconds        Float?
  boundaryType      String?
  startState        Json?
  endState          Json?
  firstFramePrompt  String?
  lastFramePrompt   String?
  firstFrameAssetId String?
  lastFrameAssetId  String?
  continuitySourceShotId String?
  promptVersion     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  @@index([projectId])
}

// Keep the original creation identity even if its project is later deleted.
model CreationRequest {
  id          String   @id
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestId   String
  requestHash String
  projectId   String
  taskId      String
  estimate    Json
  createdAt   DateTime @default(now())

  @@unique([userId, requestId])
  @@index([projectId])
}

model GenerationTask {
  id               String   @id
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId        String?
  project          Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectName      String?
  type             String
  title            String
  provider         String
  model            String
  status           String
  progress         Int      @default(0)
  estimatedCredits Int      @default(0)
  finalCredits     Int?
  billingDiscountPercent Int?
  billingQuote     Json?
  billingUsage     Json?
  billingSettlement Json?
  queuePriority    Int      @default(100)
  errorReason      String?
  jobId            String?
  requestPayload   Json?
  qualityReports   QualityReport[]
  feedbacks        UserFeedback[]
  analyticsEvents  AnalyticsEvent[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  @@index([userId])
  @@index([projectId])
}

model AnalyticsEvent {
  id            String          @id
  userId        String?
  user          User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId     String?
  eventName     String
  entityType    String?
  entityId      String?
  projectId     String?
  project       Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  taskId        String?
  task          GenerationTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  sourceChannel String?
  campaignCode  String?
  properties    Json            @default("{}")
  createdAt     DateTime        @default(now())

  @@index([userId])
  @@index([projectId])
  @@index([taskId])
  @@index([eventName])
  @@index([sourceChannel])
  @@index([createdAt])
}

model UserFeedback {
  id          String          @id
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  taskId      String?
  task        GenerationTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  assetId     String?
  asset       Asset?          @relation(fields: [assetId], references: [id], onDelete: SetNull)
  stage       String
  rating      Int             @default(0)
  usability   String          @default("usable")
  tags        String[]
  content     String          @default("")
  source      String          @default("creator")
  status      String          @default("open")
  priority    String          @default("p2")
  rootCause   String?
  assignee    String?
  resolution  String?
  convertedDatasetId String?
  processedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @default(now()) @updatedAt

  @@index([userId])
  @@index([projectId])
  @@index([taskId])
  @@index([assetId])
  @@index([stage])
  @@index([usability])
  @@index([status])
  @@index([priority])
  @@index([rootCause])
  @@index([createdAt])
}

model PlatformAnnouncement {
  id        String    @id
  title     String
  body      String
  type      String    @default("info")
  enabled   Boolean   @default(true)
  pinned    Boolean   @default(false)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([enabled])
  @@index([pinned])
  @@index([startsAt])
  @@index([endsAt])
  @@index([createdAt])
}

model SupportTicket {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  category  String
  status    String   @default("open")
  version   Int      @default(1)
  closedAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages  SupportTicketMessage[]
  requests  SupportTicketRequest[]

  @@index([userId, updatedAt, id])
  @@index([status, updatedAt, id])
}

model SupportTicketMessage {
  id         String   @id
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sequence   Int
  authorId   String
  authorName String
  authorRole String
  body       String
  createdAt  DateTime @default(now())
  requests   SupportTicketRequest[]

  @@unique([ticketId, sequence])
}

model SupportTicketRequest {
  id          String   @id
  actorId     String
  actor       User     @relation("SupportRequestActor", fields: [actorId], references: [id], onDelete: Cascade)
  kind        String
  requestId   String
  requestHash String
  ticketId    String
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  messageId   String
  message     SupportTicketMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([actorId, kind, requestId])
  @@index([ticketId])
}

model HelpArticle {
  id        String   @id
  title     String
  summary   String   @default("")
  content   String
  category  String   @default("getting_started")
  tags      String[]
  enabled   Boolean  @default(true)
  pinned    Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([enabled])
  @@index([pinned])
  @@index([sortOrder])
  @@index([createdAt])
}

model QualityReport {
  id                String          @id
  projectId         String
  project           Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  evaluationRunId   String?
  evaluationRun     EvaluationRun?  @relation(fields: [evaluationRunId], references: [id], onDelete: SetNull)
  taskId            String?
  task              GenerationTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  assetId           String?
  asset             Asset?          @relation(fields: [assetId], references: [id], onDelete: SetNull)
  stage             String
  evaluatorType     String          @default("system")
  totalScore        Int
  pass              Boolean
  dimensionScores   Json
  problems          Json
  suggestions       Json
  recommendedAction String
  promptVersion     String?
  provider          String?
  model             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([projectId])
  @@index([evaluationRunId])
  @@index([taskId])
  @@index([assetId])
  @@index([stage])
  @@index([pass])
  @@index([createdAt])
}

model EvaluationDataset {
  id          String          @id
  name        String
  description String          @default("")
  source      String          @default("manual")
  projectIds  String[]
  stages      String[]
  filters     Json            @default("{}")
  sampleCount Int             @default(0)
  owner       String?
  runs        EvaluationRun[]
  experiments ExperimentRun[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([source])
  @@index([createdAt])
}

model EvaluationRun {
  id                  String             @id
  name                String
  datasetId           String?
  dataset             EvaluationDataset? @relation(fields: [datasetId], references: [id], onDelete: SetNull)
  datasetSnapshot     Json               @default("{}")
  projectIds          String[]
  stages              String[]
  mode                String
  evaluatorModels     Json               @default("[]")
  promptVersionId     String?
  promptVersion       PromptVersion?     @relation(fields: [promptVersionId], references: [id], onDelete: SetNull)
  promptSnapshot      Json               @default("{}")
  generationPromptVersionId String?
  generationPromptSnapshot  Json          @default("{}")
  maxLlmCalls         Int                @default(0)
  maxShotsPerPrompt   Int                @default(8)
  includeFeedback     Boolean            @default(true)
  status              String             @default("running")
  usage               Json               @default("{}")
  skipped             Json               @default("[]")
  summary             Json               @default("{}")
  errorReason         String?
  project             Project?           @relation(fields: [primaryProjectId], references: [id], onDelete: SetNull)
  primaryProjectId    String?
  reports             QualityReport[]
  baselineExperiments ExperimentRun[]    @relation("ExperimentBaselineRun")
  candidateExperiments ExperimentRun[]   @relation("ExperimentCandidateRun")
  startedAt           DateTime           @default(now())
  finishedAt          DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([datasetId])
  @@index([primaryProjectId])
  @@index([mode])
  @@index([promptVersionId])
  @@index([generationPromptVersionId])
  @@index([status])
  @@index([startedAt])
}

model PromptVersion {
  id        String   @id
  key       String
  name      String
  stage     String
  purpose   String   @default("evaluation")
  version   String
  content   String
  systemPrompt      String   @default("")
  userTemplate      String   @default("")
  variableSchema    Json     @default("{}")
  outputSchema      Json     @default("{}")
  validationRules   Json     @default("[]")
  negativeRules     Json     @default("[]")
  providerOverrides Json     @default("{}")
  status    String   @default("draft")
  owner     String?
  notes     String   @default("")
  runs      EvaluationRun[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, version])
  @@index([stage])
  @@index([purpose])
  @@index([status])
}

// Production overrides are isolated from evaluation experiment versions.
// Immutable versions; the state row is updated under a per-key transaction lock.
model ProductionPromptVersion {
  id         String   @id
  key        String
  number     Int
  definition Json
  notes      String   @default("")
  owner      String
  createdAt  DateTime @default(now())
  @@unique([key, number])
}

model ProductionPromptState {
  key             String   @id
  activeVersionId String?
  revision        Int      @default(0)
  updatedAt       DateTime @updatedAt
}

model StyleProfile {
  id             String   @id
  key            String   @unique
  name           String
  category       String
  summary        String   @default("")
  characterRules Json     @default("[]")
  sceneRules     Json     @default("[]")
  lightingRules  Json     @default("[]")
  cameraRules    Json     @default("[]")
  materialRules  Json     @default("[]")
  negativeRules  Json     @default("[]")
  enabled        Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([category, enabled, sortOrder])
}

model ExperimentRun {
  id               String    @id
  name             String
  stage            String
  hypothesis       String
  baselineVersion  String
  candidateVersion String
  experimentType   String    @default("model")
  datasetId        String?
  dataset          EvaluationDataset? @relation(fields: [datasetId], references: [id], onDelete: SetNull)
  baselineRunId    String?
  baselineRun      EvaluationRun? @relation("ExperimentBaselineRun", fields: [baselineRunId], references: [id], onDelete: SetNull)
  candidateRunId   String?
  candidateRun     EvaluationRun? @relation("ExperimentCandidateRun", fields: [candidateRunId], references: [id], onDelete: SetNull)
  baselineConfig   Json      @default("{}")
  candidateConfig  Json      @default("{}")
  metrics          Json      @default("{}")
  winner           String    @default("pending")
  trafficRatio     Int       @default(0)
  successMetric    String
  resultSummary    String    @default("")
  status           String    @default("draft")
  startAt          DateTime?
  endAt            DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([stage])
  @@index([status])
  @@index([datasetId])
  @@index([baselineRunId])
  @@index([candidateRunId])
}

model CampaignCode {
  id                    String    @id
  campaignName          String
  sourceChannel         String
  codePrefix            String
  quota                 Int
  credits               Int
  validUntil            DateTime?
  createdCount          Int       @default(0)
  redeemedCount         Int       @default(0)
  activatedProjectCount Int       @default(0)
  effectiveProjectCount Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([sourceChannel])
  @@index([codePrefix])
}

model CreditAccount {
  id            String   @id
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance       Int      @default(0)
  frozenBalance Int      @default(0)
  totalRecharge Int      @default(0)
  totalConsume  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CreditPricingPolicy {
  id        String   @id
  version   Int      @default(1)
  policy    Json
  updatedAt DateTime @updatedAt
}

model CreditFundingLot {
  id             String   @id
  sequence       Int      @unique @default(autoincrement())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  source         String
  originalCredits Int
  remainingCredits Int
  cashMicros     BigInt?
  referenceId    String?
  createdAt      DateTime @default(now())
  @@index([userId, createdAt])
  @@index([source, remainingCredits])
}

model CreditTransaction {
  id           String   @id
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId    String?
  project      Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  taskId       String?
  type         String
  amount       Int
  balanceAfter Int
  description  String
  createdAt    DateTime @default(now())
  @@index([userId])
  @@index([projectId])
  @@index([taskId, userId, type])
}

model RechargeOrder {
  id              String          @id
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId          String?
  planName        String
  channel         String
  amountCny       Float
  amountFen       Int?
  requestId       String?
  requestHash     String?
  kind            String          @default("recharge")
  membershipPlanId String?
  membershipDiscountPercent Int   @default(0)
  membershipPriorityLevel Int     @default(0)
  membershipStartsAt DateTime?
  membershipEndsAt DateTime?
  codeUrl         String?
  expiresAt       DateTime?
  checkedAt       DateTime?
  checkoutLeaseUntil DateTime?
  reconcileError  String?
  credits         Int
  bonusCredits    Int             @default(0)
  status          String          @default("pending")
  providerTradeNo String?
  paidAt          DateTime?
  invoiceStatus   String          @default("none")
  payments        PaymentRecord[]
  invoices        Invoice[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([userId])
  @@index([status])
  @@unique([userId, requestId])
  @@index([channel, status, checkedAt])
}

model UserMembership {
  userId          String   @id
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId          String
  planName        String
  startsAt        DateTime
  endsAt          DateTime
  discountPercent Int
  priorityLevel   Int
  updatedAt       DateTime @updatedAt
}

model PaymentRecord {
  id              String        @id
  orderId         String
  order           RechargeOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  channel         String
  providerTradeNo String?
  amountCny       Float
  status          String        @default("pending")
  callbackPayload String?
  createdAt       DateTime      @default(now())

  @@index([orderId])
  @@index([providerTradeNo])
}

model Invoice {
  id        String        @id
  orderId   String
  order     RechargeOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  taxNo     String?
  email     String?
  amountCny Float
  status    String        @default("requested")
  issuedAt  DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([userId])
  @@index([orderId])
}

model ExportJob {
  id          String   @id
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type        String
  status      String   @default("pending")
  outputUrl   String?
  errorReason String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  outcome     ExportOutcome?

  @@index([userId])
  @@index([projectId])
}

model Plan {
  id           String   @id
  name         String
  price        Float
  credits      Int
  bonusCredits Int      @default(0)
  badge        String?
  features     String[]
  shopUrl      String?
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
}

model MembershipPlan {
  id              String   @id
  name            String
  monthlyPrice    Float
  monthlyCredits  Int
  discountPercent Int      @default(0)
  priorityLevel   Int      @default(0)
  badge           String?
  features        String[]
  shopUrl         String?
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model RedeemCode {
  id             String             @id
  batchId        String?
  batch          RedeemBatch?       @relation(fields: [batchId], references: [id], onDelete: SetNull)
  code           String             @unique
  name           String
  credits        Int
  maxRedemptions Int                @default(1)
  usedCount      Int                @default(0)
  enabled        Boolean            @default(true)
  startsAt       DateTime?
  endsAt         DateTime?
  redemptions    RedeemRedemption[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  @@index([batchId])
  @@index([createdAt, id])
}

model RedeemBatch {
  id         String       @id
  requestHash String?
  name       String
  prefix     String
  credits    Int
  totalCodes Int
  enabled    Boolean      @default(true)
  codes      RedeemCode[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  @@index([createdAt, id])
}

model RedeemRedemption {
  id           String     @id
  redeemCodeId String
  redeemCode   RedeemCode @relation(fields: [redeemCodeId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  credits      Int
  createdAt    DateTime   @default(now())
  @@index([redeemCodeId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt, id])
}

model ModelProvider {
  id         String   @id
  name       String
  modality   String
  enabled    Boolean  @default(false)
  baseUrl    String?
  apiKey     String?
  iconUrl    String?
  models     String[]
  capability Json
  costHint   String
  prices     ModelPrice[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ModelPrice {
  id            String        @id
  providerId    String?
  provider      ModelProvider? @relation(fields: [providerId], references: [id], onDelete: Cascade)
  providerName  String
  modality      String
  model         String
  unit          String
  unitCredits   Int
  vendorCostCny Float         @default(0)
  billing       Json?
  enabled       Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  @@index([providerId])
}

model PromptTemplate {
  id        String   @id
  name      String
  type      String
  version   String
  enabled   Boolean  @default(true)
  summary   String
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContentProject {
  id                 String   @id
  userId             String
  title              String
  mode               String
  status             String   @default("draft")
  styleProfile       Json     @default("{}")
  activeStep         String   @default("source")
  textProvider       String   @default("manjiao")
  textModel          String   @default("gpt-5.5")
  productionProjectId String?
  importKey          String?  @unique
  brief              Json     @default("{}")
  revision           Int      @default(1)
  parentContentId    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  sources            SourceDocument[]
  analyses           StoryAnalysis[]
  outlines           StoryOutline[]
  chapters           StoryChapter[]
  scripts            ScriptVersion[]
  entities           EntityCatalog?
  episodes           ProductionEpisode[]
  facts              StoryFact[]
  creatorRuns        CreatorRun[]

  @@index([userId, updatedAt])
  @@index([status])
}

model CreatorPreference {
  userId       String   @id
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  guideVersion Int      @default(1)
  guideState   String   @default("new")
  updatedAt    DateTime @updatedAt
}

model ExportOutcome {
  exportJobId       String   @id
  exportJob         ExportJob @relation(fields: [exportJobId], references: [id], onDelete: Cascade)
  userId            String
  outputFingerprint String
  verdict           String
  note              String   @default("")
  revision          Int      @default(1)
  history           Json     @default("[]")
  updatedAt         DateTime @updatedAt

  @@index([userId])
}

// Append-only facts; an author revision supersedes a row without destroying evidence.
model StoryFact {
  id               String   @id
  contentProjectId String
  contentProject   ContentProject @relation(fields: [contentProjectId], references: [id], onDelete: Cascade)
  subject          String
  predicate        String
  value            String
  status           String   @default("candidate")
  sourceType       String
  sourceId         String
  sourceVersion    Int
  validFrom        Int      @default(1)
  validTo          Int?
  knownBy          String[]
  supersedesId     String?
  revision         Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([contentProjectId, status, validFrom])
  @@index([contentProjectId, sourceId])
}

model CreatorRun {
  id               String   @id
  userId           String
  contentProjectId String
  contentProject   ContentProject @relation(fields: [contentProjectId], references: [id], onDelete: Cascade)
  requestId        String
  inputHash        String
  input            Json
  inputRevision    Int
  skillVersion     String
  status           String   @default("pending")
  maxCalls         Int      @default(1)
  maximumCredits   Int
  cancelRequested  Boolean  @default(false)
  error            String?
  steps            CreatorStep[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, requestId])
  @@index([contentProjectId, createdAt])
}

model CreatorStep {
  id            String   @id
  runId         String
  run           CreatorRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  sequence      Int
  tool          String
  status        String   @default("pending")
  taskId        String?
  inputManifest Json     @default("{}")
  output        Json     @default("{}")
  findings      Json     @default("[]")
  error         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([runId, sequence])
}

model ProductionEpisode {
  id                    String   @id
  contentProjectId      String
  productionProjectId   String?
  episodeNo             Int
  title                 String   @default("")
  sourceStart           Int
  sourceEnd             Int
  sourceCharacterCount  Int
  targetDurationSeconds Int      @default(180)
  status                String   @default("draft")
  activeScriptVersion   Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  contentProject        ContentProject @relation(fields: [contentProjectId], references: [id], onDelete: Cascade)
  productionProject     Project? @relation(fields: [productionProjectId], references: [id], onDelete: SetNull)
  scripts               EpisodeScriptVersion[]

  @@unique([contentProjectId, episodeNo])
  @@index([productionProjectId, episodeNo])
}

model EpisodeScriptVersion {
  id               String   @id
  episodeId        String
  version          Int
  status           String   @default("draft")
  content          String
  structuredResult Json     @default("{}")
  promptSnapshot   Json     @default("{}")
  createdAt        DateTime @default(now())
  episode          ProductionEpisode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([episodeId, version])
}

model SourceDocument {
  id          String   @id
  contentProjectId String
  kind        String
  title       String
  content     String
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  contentProject ContentProject @relation(fields: [contentProjectId], references: [id], onDelete: Cascade)

  @@index([contentProjectId])
}

model StoryAnalysis {
  id          String   @id
  contentProjectId String
  version     Int      @default(1)
  status      String   @default("draft")
  result      Json     @default("{}")
  promptSnapshot Json   @default("{}")
  createdAt   DateTime @default(now())
  contentProject ContentProject @relation(fields: [contentProjectId], references: [id], onDelete: Cascade)

  @@index([contentProjectId, version])
}

model StoryOutline {
  id          String   @id
  contentProjectId String
  version     Int      @default(1)
  status      String   @default("draft")
  result      Json     @default("{}")
  promptSnapshot Json   @default("{}")
  createdAt   DateTime @default(now())
  contentProject ContentProject @relation(fields: [contentProjectId], references: [id], onDelete: Cascade)

  @@index([contentProjectId, version])
}

model StoryChapter {
  id          String   @id
  contentProjectId String
  chapterNo   Int
  title       String   @default("")
  status      String   @default("draft")
  content     String   @default("")
  result      Json     @default("{}")
  promptSnapshot Json  @default("{}")
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  contentProject ContentProject @relation(fields: [contentProjectId], references: [id], onDelete: Cascade)

  @@unique([contentProjectId, chapterNo, version])
  @@index([contentProjectId, chapterNo])
}

model ScriptVersion {
  id          String   @id
  contentProjectId String
  version     Int      @default(1)
  status      String   @default("draft")
  content     String
  result      Json     @default("{}")
  promptSnapshot Json  @default("{}")
  createdAt   DateTime @default(now())
  contentProject ContentProject @relation(fields: [contentProjectId], references: [id], onDelete: Cascade)

  @@index([contentProjectId, version])
}

model EntityCatalog {
  id          String   @id
  contentProjectId String @unique
  version     Int      @default(1)
  characters  Json     @default("[]")
  scenes      Json     @default("[]")
  props       Json     @default("[]")
  promptSnapshot Json  @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  contentProject ContentProject @relation(fields: [contentProjectId], references: [id], onDelete: Cascade)
}


