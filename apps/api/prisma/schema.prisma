generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id
  name         String
  email        String?       @unique
  phone        String?       @unique
  avatarUrl    String?
  passwordHash String?
  role         String        @default("creator")
  status       String        @default("active")
  projects     Project[]
  credit       CreditAccount?
  transactions CreditTransaction[]
  tasks        GenerationTask[]
  redemptions  RedeemRedemption[]
  sessions     AuthSession[]
  orders       RechargeOrder[]
  invoices     Invoice[]
  exportJobs   ExportJob[]
  analyticsEvents AnalyticsEvent[]
  feedbacks    UserFeedback[]
  showcaseWorks ShowcaseWork[]
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}
model AuthSession {
  id         String    @id
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  lastUsedAt DateTime  @default(now())
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Project {
  id           String           @id
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  type         String
  intro        String           @default("")
  sourceType   String
  artStyle     String
  videoRatio   String
  textProvider  String?
  textModel     String?
  imageProvider String?
  imageModel    String?
  imageSize     String?
  imageQuality  String?
  videoProvider String?
  videoModel    String?
  status       String
  episodes     Int             @default(1)
  storyboards  Int             @default(0)
  characters   Int             @default(0)
  imageAssets  Int             @default(0)
  videoClips   Int             @default(0)
  creditsSpent Int             @default(0)
  scripts      ScriptDraft[]
  characterSet Character[]
  assets       Asset[]
  shots        Storyboard[]
  tasks        GenerationTask[]
  transactions CreditTransaction[]
  exportJobs   ExportJob[]
  qualityReports QualityReport[]
  evaluationRuns EvaluationRun[]
  feedbacks    UserFeedback[]
  analyticsEvents AnalyticsEvent[]
  showcaseWorks ShowcaseWork[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model ScriptDraft {
  id        String   @id
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  content   String
  synopsis  String
  version   Int      @default(1)
  createdAt DateTime @default(now())
}

model Character {
  id               String   @id
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name             String
  identity         String
  appearance       String
  costume          String
  personality      String
  prompt           String
  negativePrompt   String
  referenceAssetId String?
  voiceId          String?
  seed             Int?
  consistencyLevel String   @default("medium")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Asset {
  id                 String   @id
  projectId          String
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type               String
  name               String
  description        String
  prompt             String
  referenceUrl       String?
  status             String
  relatedCharacterId String?
  qualityReports     QualityReport[]
  feedbacks          UserFeedback[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model ShowcaseWork {
  id             String    @id
  creatorId      String?
  creator        User?     @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  projectId      String?
  project        Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  sourceAssetId  String?
  title          String
  description    String    @default("")
  category       String    @default("AI短剧")
  authorName     String    @default("")
  coverUrl       String
  videoUrl       String
  durationLabel  String    @default("00:00")
  status         String    @default("pending")
  featured       Boolean   @default(false)
  sortOrder      Int       @default(0)
  reviewNote     String    @default("")
  submittedAt    DateTime?
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, featured, sortOrder])
  @@index([creatorId, createdAt])
  @@index([projectId])
}

model Storyboard {
  id                String   @id
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  episodeNo         Int
  sceneNo           Int
  shotNo            Int
  duration          Int
  shotSize          String
  cameraAngle       String
  cameraMovement    String
  characters        String[]
  scene             String
  pictureDesc       String
  action            String   @default("")
  orientation       String   @default("")
  spatialRelation   String   @default("")
  emotion           String   @default("")
  dialogue          String
  voiceOver         String
  environmentSound  String
  soundEffect       String
  imagePrompt       String
  videoPrompt       String
  referenceAssetIds String[]
  status            String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model GenerationTask {
  id               String   @id
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId        String?
  project          Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectName      String?
  type             String
  title            String
  provider         String
  model            String
  status           String
  progress         Int      @default(0)
  estimatedCredits Int      @default(0)
  finalCredits     Int?
  errorReason      String?
  jobId            String?
  qualityReports   QualityReport[]
  feedbacks        UserFeedback[]
  analyticsEvents  AnalyticsEvent[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model AnalyticsEvent {
  id            String          @id
  userId        String?
  user          User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId     String?
  eventName     String
  entityType    String?
  entityId      String?
  projectId     String?
  project       Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  taskId        String?
  task          GenerationTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  sourceChannel String?
  campaignCode  String?
  properties    Json            @default("{}")
  createdAt     DateTime        @default(now())

  @@index([userId])
  @@index([projectId])
  @@index([taskId])
  @@index([eventName])
  @@index([sourceChannel])
  @@index([createdAt])
}

model UserFeedback {
  id          String          @id
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  taskId      String?
  task        GenerationTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  assetId     String?
  asset       Asset?          @relation(fields: [assetId], references: [id], onDelete: SetNull)
  stage       String
  rating      Int             @default(0)
  usability   String          @default("usable")
  tags        String[]
  content     String          @default("")
  source      String          @default("creator")
  status      String          @default("open")
  priority    String          @default("p2")
  rootCause   String?
  assignee    String?
  resolution  String?
  convertedDatasetId String?
  processedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @default(now()) @updatedAt

  @@index([userId])
  @@index([projectId])
  @@index([taskId])
  @@index([assetId])
  @@index([stage])
  @@index([usability])
  @@index([status])
  @@index([priority])
  @@index([rootCause])
  @@index([createdAt])
}

model PlatformAnnouncement {
  id        String    @id
  title     String
  body      String
  type      String    @default("info")
  enabled   Boolean   @default(true)
  pinned    Boolean   @default(false)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([enabled])
  @@index([pinned])
  @@index([startsAt])
  @@index([endsAt])
  @@index([createdAt])
}

model HelpArticle {
  id        String   @id
  title     String
  summary   String   @default("")
  content   String
  category  String   @default("getting_started")
  tags      String[]
  enabled   Boolean  @default(true)
  pinned    Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([enabled])
  @@index([pinned])
  @@index([sortOrder])
  @@index([createdAt])
}

model QualityReport {
  id                String          @id
  projectId         String
  project           Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  evaluationRunId   String?
  evaluationRun     EvaluationRun?  @relation(fields: [evaluationRunId], references: [id], onDelete: SetNull)
  taskId            String?
  task              GenerationTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  assetId           String?
  asset             Asset?          @relation(fields: [assetId], references: [id], onDelete: SetNull)
  stage             String
  evaluatorType     String          @default("system")
  totalScore        Int
  pass              Boolean
  dimensionScores   Json
  problems          Json
  suggestions       Json
  recommendedAction String
  promptVersion     String?
  provider          String?
  model             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([projectId])
  @@index([evaluationRunId])
  @@index([taskId])
  @@index([assetId])
  @@index([stage])
  @@index([pass])
  @@index([createdAt])
}

model EvaluationDataset {
  id          String          @id
  name        String
  description String          @default("")
  source      String          @default("manual")
  projectIds  String[]
  stages      String[]
  filters     Json            @default("{}")
  sampleCount Int             @default(0)
  owner       String?
  runs        EvaluationRun[]
  experiments ExperimentRun[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([source])
  @@index([createdAt])
}

model EvaluationRun {
  id                  String             @id
  name                String
  datasetId           String?
  dataset             EvaluationDataset? @relation(fields: [datasetId], references: [id], onDelete: SetNull)
  datasetSnapshot     Json               @default("{}")
  projectIds          String[]
  stages              String[]
  mode                String
  evaluatorModels     Json               @default("[]")
  promptVersionId     String?
  promptVersion       PromptVersion?     @relation(fields: [promptVersionId], references: [id], onDelete: SetNull)
  promptSnapshot      Json               @default("{}")
  generationPromptVersionId String?
  generationPromptSnapshot  Json          @default("{}")
  maxLlmCalls         Int                @default(0)
  maxShotsPerPrompt   Int                @default(8)
  includeFeedback     Boolean            @default(true)
  status              String             @default("running")
  usage               Json               @default("{}")
  skipped             Json               @default("[]")
  summary             Json               @default("{}")
  errorReason         String?
  project             Project?           @relation(fields: [primaryProjectId], references: [id], onDelete: SetNull)
  primaryProjectId    String?
  reports             QualityReport[]
  baselineExperiments ExperimentRun[]    @relation("ExperimentBaselineRun")
  candidateExperiments ExperimentRun[]   @relation("ExperimentCandidateRun")
  startedAt           DateTime           @default(now())
  finishedAt          DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([datasetId])
  @@index([primaryProjectId])
  @@index([mode])
  @@index([promptVersionId])
  @@index([generationPromptVersionId])
  @@index([status])
  @@index([startedAt])
}

model PromptVersion {
  id        String   @id
  key       String
  name      String
  stage     String
  purpose   String   @default("evaluation")
  version   String
  content   String
  status    String   @default("draft")
  owner     String?
  notes     String   @default("")
  runs      EvaluationRun[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, version])
  @@index([stage])
  @@index([purpose])
  @@index([status])
}

model ExperimentRun {
  id               String    @id
  name             String
  stage            String
  hypothesis       String
  baselineVersion  String
  candidateVersion String
  experimentType   String    @default("model")
  datasetId        String?
  dataset          EvaluationDataset? @relation(fields: [datasetId], references: [id], onDelete: SetNull)
  baselineRunId    String?
  baselineRun      EvaluationRun? @relation("ExperimentBaselineRun", fields: [baselineRunId], references: [id], onDelete: SetNull)
  candidateRunId   String?
  candidateRun     EvaluationRun? @relation("ExperimentCandidateRun", fields: [candidateRunId], references: [id], onDelete: SetNull)
  baselineConfig   Json      @default("{}")
  candidateConfig  Json      @default("{}")
  metrics          Json      @default("{}")
  winner           String    @default("pending")
  trafficRatio     Int       @default(0)
  successMetric    String
  resultSummary    String    @default("")
  status           String    @default("draft")
  startAt          DateTime?
  endAt            DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([stage])
  @@index([status])
  @@index([datasetId])
  @@index([baselineRunId])
  @@index([candidateRunId])
}

model CampaignCode {
  id                    String    @id
  campaignName          String
  sourceChannel         String
  codePrefix            String
  quota                 Int
  credits               Int
  validUntil            DateTime?
  createdCount          Int       @default(0)
  redeemedCount         Int       @default(0)
  activatedProjectCount Int       @default(0)
  effectiveProjectCount Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([sourceChannel])
  @@index([codePrefix])
}

model CreditAccount {
  id            String   @id
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance       Int      @default(0)
  frozenBalance Int      @default(0)
  totalRecharge Int      @default(0)
  totalConsume  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CreditTransaction {
  id           String   @id
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId    String?
  project      Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  taskId       String?
  type         String
  amount       Int
  balanceAfter Int
  description  String
  createdAt    DateTime @default(now())
}

model RechargeOrder {
  id              String          @id
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId          String?
  planName        String
  channel         String
  amountCny       Float
  credits         Int
  bonusCredits    Int             @default(0)
  status          String          @default("pending")
  providerTradeNo String?
  paidAt          DateTime?
  invoiceStatus   String          @default("none")
  payments        PaymentRecord[]
  invoices        Invoice[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([userId])
  @@index([status])
}

model PaymentRecord {
  id              String        @id
  orderId         String
  order           RechargeOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  channel         String
  providerTradeNo String?
  amountCny       Float
  status          String        @default("pending")
  callbackPayload String?
  createdAt       DateTime      @default(now())

  @@index([orderId])
  @@index([providerTradeNo])
}

model Invoice {
  id        String        @id
  orderId   String
  order     RechargeOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  taxNo     String?
  email     String?
  amountCny Float
  status    String        @default("requested")
  issuedAt  DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([userId])
  @@index([orderId])
}

model ExportJob {
  id          String   @id
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type        String
  status      String   @default("pending")
  outputUrl   String?
  errorReason String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([projectId])
}

model Plan {
  id           String   @id
  name         String
  price        Float
  credits      Int
  bonusCredits Int      @default(0)
  badge        String?
  features     String[]
  shopUrl      String?
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
}

model MembershipPlan {
  id              String   @id
  name            String
  monthlyPrice    Float
  monthlyCredits  Int
  discountPercent Int      @default(0)
  priorityLevel   Int      @default(0)
  badge           String?
  features        String[]
  shopUrl         String?
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model RedeemCode {
  id             String             @id
  batchId        String?
  batch          RedeemBatch?       @relation(fields: [batchId], references: [id], onDelete: SetNull)
  code           String             @unique
  name           String
  credits        Int
  maxRedemptions Int                @default(1)
  usedCount      Int                @default(0)
  enabled        Boolean            @default(true)
  startsAt       DateTime?
  endsAt         DateTime?
  redemptions    RedeemRedemption[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

model RedeemBatch {
  id         String       @id
  name       String
  prefix     String
  credits    Int
  totalCodes Int
  enabled    Boolean      @default(true)
  codes      RedeemCode[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

model RedeemRedemption {
  id           String     @id
  redeemCodeId String
  redeemCode   RedeemCode @relation(fields: [redeemCodeId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  credits      Int
  createdAt    DateTime   @default(now())
}

model ModelProvider {
  id         String   @id
  name       String
  modality   String
  enabled    Boolean  @default(false)
  baseUrl    String?
  apiKey     String?
  iconUrl    String?
  models     String[]
  capability Json
  costHint   String
  prices     ModelPrice[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ModelPrice {
  id            String        @id
  providerId    String?
  provider      ModelProvider? @relation(fields: [providerId], references: [id], onDelete: Cascade)
  providerName  String
  modality      String
  model         String
  unit          String
  unitCredits   Int
  vendorCostCny Float         @default(0)
  enabled       Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model PromptTemplate {
  id        String   @id
  name      String
  type      String
  version   String
  enabled   Boolean  @default(true)
  summary   String
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


