# Web
VITE_API_BASE_URL=http://localhost:4000/api
VITE_ICP_NUMBER=
# Optional: serve landing-page videos/posters from a static domain or CDN origin.
VITE_CINE_ASSET_BASE_URL=
VITE_CINE_MEDIA_TIER=fast

# API
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://aigc:aigc@localhost:5432/aigc_drama?schema=public
REDIS_URL=redis://localhost:6379
SEED_DEMO_DATA=true
SEED_DEMO_USER=true
SEED_DEFAULT_USERS=true
ADMIN_SEED_PASSWORD=admin123456
ENABLE_MOCK_PAYMENT=true
AUTH_SESSION_TTL_DAYS=30
API_ACCESS_LOG=false
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=180
REDIS_HEALTH_TIMEOUT_MS=1000
GENERATION_JOB_ATTEMPTS=3
GENERATION_JOB_BACKOFF_MS=5000
OBJECT_STORAGE_LOCAL_DIR=../../storage
PUBLIC_STORAGE_BUCKETS=images,videos,audio,exports

# Text model: Alibaba Cloud Bailian / DashScope OpenAI-compatible endpoint.
DASHSCOPE_TEXT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_TEXT_API_KEY=
DASHSCOPE_TEXT_MODEL=qwen3.7-plus
DASHSCOPE_TEXT_MODEL_POOL=qwen3.7-plus,qwen3.7-max-2026-05-17,qwen3.7-max-2026-06-08,qwen3.6-flash-2026-04-16,deepseek-v4-flash,qwen3.6-35b-a3b,glm-5.1,tongyi-xiaomi-analysis-pro,tongyi-xiaomi-analysis-flash,qwen3.5-ocr
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_API_KEY=

# Pipp OpenAI-compatible relay. Put the real key in server environment only.
PIPP_TEXT_BASE_URL=https://ripp.best
PIPP_TEXT_MODEL=deepseek-v4-pro
PIPP_TEXT_API_KEY=

# JXB upstream relay. Put keys in .env only; do not commit real secrets.
JXB_BASE_URL=http://47.116.22.0:3000/v1
JXB_TEXT_MODEL=gpt-5.5
JXB_TEXT_API_KEY=
JXB_API_KEY=
JXB_DEEPSEEK_MODEL=deepseek-ai/deepseek-v4-pro
JXB_DEEPSEEK_API_KEY=
JXB_IMAGE_MODEL=gpt-image-2
JXB_IMAGE_API_KEY=

# Google AI Studio / Gemini. Put the real key in .env only.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TEXT_MODEL=gemini-3.1-pro-preview
GEMINI_IMAGE_MODEL=gemini-3-pro-image
GEMINI_IMAGE_SIZE=1K
GEMINI_API_KEY=

# Optional OpenAI-compatible fallback, for relay providers.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_API_KEY=

# Optional OpenAI Responses upstream relay.
OPENAI_BASE_URL=https://subapi.muxueai.pro
OPENAI_TEXT_WIRE_API=responses
OPENAI_TEXT_MODEL=gpt-5.5
OPENAI_REASONING_EFFORT=low
OPENAI_GENERATION_MAX_OUTPUT_TOKENS=2400
OPENAI_DISABLE_RESPONSE_STORAGE=true
OPENAI_API_KEY=

# Image generation adapter.
# Supported: mock, dashscope, google-gemini-image, zml-image, openai-compatible, doubao-seedream.
# High-quality default: ZML relay + gpt-image-2. It can take 60-180s per image.
IMAGE_PROVIDER=dashscope
IMAGE_BATCH_LIMIT=2
CHARACTER_IMAGE_BATCH_LIMIT=3
ZML_IMAGE_QUALITY=medium
VIDEO_BATCH_LIMIT=1
IMAGE_REQUEST_TIMEOUT_MS=75000
ZML_BASE_URL=https://api.zmlmfling.com
ZML_API_KEY=
ZML_IMAGE_MODEL=gpt-image-2
ZML_IMAGE_REQUEST_TIMEOUT_MS=300000

# Optional OpenAI-compatible image adapter. Many relay sites expose /images/generations.
OPENAI_IMAGE_BASE_URL=https://subapi.muxueai.pro
OPENAI_IMAGE_API_KEY=
OPENAI_IMAGE_MODEL=openai-compatible-image

# Optional Alibaba Cloud Model Studio / DashScope image adapter.
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_API_KEY=
DASHSCOPE_IMAGE_MODEL=qwen-image-2.0-pro-2026-04-22
DASHSCOPE_IMAGE_MODEL_POOL=qwen-image-2.0-pro-2026-04-22,qwen-image-2.0-pro-2026-06-22,qwen-image,qwen-image-plus

# Optional advanced local workflow.
COMFYUI_BASE_URL=http://localhost:8188

# Video generation. Local /storage images cannot be downloaded by external providers unless PUBLIC_API_BASE_URL is set.
PUBLIC_API_BASE_URL=http://localhost:4000
VIDEO_PROVIDER=dashscope-video
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_API_KEY=
DOUBAO_SEEDANCE_MODEL=doubao-seedance-1-5-pro-251215
# Prefer authorized Ark endpoint IDs (ep-...) for the collaboration reward plan.
# The video adapter tries the selected model first, then this pool, then backend provider models.
DOUBAO_SEEDANCE_MODEL_POOL=ep-20260703111128-95wms,Doubao-Seedance-1.5-pro,Doubao-Seedance-1.0-pro,Doubao-Seedance-1.0-lite-i2v,Doubao-Seedance-1.0-lite-t2v
DASHSCOPE_VIDEO_MODEL=wan2.7-i2v-2026-04-25
DASHSCOPE_VIDEO_MODEL_POOL=wan2.7-i2v-2026-04-25,happyhorse-1.1-i2v,happyhorse-1.1-r2v,happyhorse-1.1-t2v,happyhorse-1.0-video-edit,wanx2.1-i2v-turbo,wanx2.1-i2v-plus
VIDEO_SUBMIT_POLL_TIMEOUT_MS=8000
DOUBAO_VIDEO_POLL_TIMEOUT_MS=45000
VIDEO_MODEL_RATE_LIMIT_COOLDOWN_MS=120000
# Optional local guardrail. Example: {"doubao-seedance":{"ep-20260703111128-95wms":20,"Doubao-Seedance-1.0-lite-i2v":50}}
VIDEO_MODEL_DAILY_TASK_LIMITS=

# TTS / final export. Default to DashScope official TTS, keep easyVoice as optional legacy adapter.
TTS_PROVIDER=dashscope-tts
DASHSCOPE_TTS_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_TTS_API_KEY=
DASHSCOPE_TTS_MODEL=qwen3-tts-flash
DASHSCOPE_TTS_DEFAULT_VOICE=Cherry
# Optional LongCat-AudioDiT open-source TTS sidecar.
# Recommended production mode: run the Python service on a GPU host/cloud server and point this URL to it.
# Local bridge is disabled by default so model weights are not downloaded into this repo/E: drive.
# Use LONGCAT_AUDIODIT_PROMPT_MAP to bind character names to reference audio and transcript.
# Example: {"旁白":{"promptAudio":"/storage/voices/narrator.wav","promptText":"这里填写参考音频对应文本"}}
LONGCAT_AUDIODIT_BASE_URL=
LONGCAT_AUDIODIT_TTS_PATH=/tts
LONGCAT_AUDIODIT_MODEL=meituan-longcat/LongCat-AudioDiT-1B
LONGCAT_AUDIODIT_TOKENIZER_MODEL=
# Dev-only escape hatch. Keep false/empty in normal local and production environments.
LONGCAT_AUDIODIT_ALLOW_LOCAL_BRIDGE=false
LONGCAT_AUDIODIT_REPO_DIR=
LONGCAT_AUDIODIT_PYTHON=python
LONGCAT_AUDIODIT_DEVICE=cuda
LONGCAT_AUDIODIT_DTYPE=auto
LONGCAT_AUDIODIT_GUIDANCE_METHOD=apg
LONGCAT_AUDIODIT_GUIDANCE_STRENGTH=4
LONGCAT_AUDIODIT_NFE=16
LONGCAT_AUDIODIT_TIMEOUT_MS=900000
LONGCAT_AUDIODIT_PROMPT_MAP=
EASYVOICE_BASE_URL=http://127.0.0.1:3000
EASYVOICE_TTS_PATH=/api/v1/tts/generateJson
EASYVOICE_DEFAULT_VOICE=zh-CN-XiaoxiaoNeural
FFMPEG_BIN=
