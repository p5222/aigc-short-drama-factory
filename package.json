{
  "name": "aigc-short-drama-factory",
  "version": "0.1.0",
  "private": true,
  "description": "Professional AIGC short drama and manga production SaaS prototype.",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @aifilm/web --filter @aifilm/api dev",
    "dev:web": "pnpm --filter @aifilm/web dev",
    "dev:api": "pnpm --filter @aifilm/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test:unit",
    "push:safe": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/safe_push.ps1",
    "ship:server": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ship_server.ps1"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
