[Unit]
Description=Manjiao complete database media source and Redis backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
ExecStart=/bin/bash /opt/manjiao/deploy/scheduled_backup.sh
TimeoutStartSec=1200
