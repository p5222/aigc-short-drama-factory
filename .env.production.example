# Copy this file to .env.production on the server and fill real secrets there.
# Do not commit .env.production.

NODE_ENV=production
API_PORT=4000
WEB_ORIGIN=http://YOUR_SERVER_IP
PUBLIC_API_BASE_URL=http://YOUR_SERVER_IP
VITE_API_BASE_URL=/api

POSTGRES_USER=aigc
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=aigc_drama
DATABASE_URL=postgresql://aigc:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/aigc_drama?schema=public

REDIS_URL=redis://redis:6379
SEED_DEMO_DATA=true
ADMIN_SEED_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
AUTH_SESSION_TTL_DAYS=30
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=180
GENERATION_JOB_ATTEMPTS=3
GENERATION_JOB_BACKOFF_MS=5000
OBJECT_STORAGE_LOCAL_DIR=/app/storage

# Text models
DASHSCOPE_TEXT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_TEXT_API_KEY=
DASHSCOPE_TEXT_MODEL=qwen3.7-plus
DASHSCOPE_TEXT_MODEL_POOL=qwen3.7-plus,qwen3.7-max-2026-05-17,qwen3.7-max-2026-06-08,qwen3.6-flash-2026-04-16,deepseek-v4-flash,qwen3.6-35b-a3b,glm-5.1,tongyi-xiaomi-analysis-pro,tongyi-xiaomi-analysis-flash,qwen3.5-ocr
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_API_KEY=
DASHSCOPE_IMAGE_MODEL=qwen-image-2.0-pro-2026-04-22
DASHSCOPE_IMAGE_MODEL_POOL=qwen-image-2.0-pro-2026-04-22,qwen-image-2.0-pro-2026-06-22,qwen-image,qwen-image-plus

# Doubao / Volcengine Ark
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_API_KEY=
DOUBAO_SEEDREAM_MODEL=doubao-seedream-5-0-lite-260128
DOUBAO_SEEDANCE_MODEL=doubao-seedance-1-5-pro-251215
VIDEO_MODEL_TEST_MODE=config
DASHSCOPE_VIDEO_MODEL=wan2.7-i2v-2026-04-25
DASHSCOPE_VIDEO_MODEL_POOL=wan2.7-i2v-2026-04-25,happyhorse-1.1-i2v,happyhorse-1.1-r2v,happyhorse-1.1-t2v,happyhorse-1.0-video-edit,wanx2.1-i2v-turbo,wanx2.1-i2v-plus

# ZML relay
ZML_BASE_URL=https://api.zmlmfling.com
ZML_API_KEY=
ZML_TEXT_MODEL=gpt-5.5
ZML_IMAGE_MODEL=gpt-image-2
ZML_IMAGE_REQUEST_TIMEOUT_MS=300000

# TTS and MP4 export
TTS_PROVIDER=dashscope-tts
DASHSCOPE_TTS_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_TTS_API_KEY=
DASHSCOPE_TTS_MODEL=qwen3-tts-flash
DASHSCOPE_TTS_DEFAULT_VOICE=Cherry
EASYVOICE_BASE_URL=http://easyvoice:3000
EASYVOICE_TTS_PATH=/api/v1/tts/generateJson
EASYVOICE_DEFAULT_VOICE=zh-CN-XiaoxiaoNeural
# Optional: set when ffmpeg is not in PATH. The API also probes tools/ffmpeg/bin, vendor/ffmpeg/bin and deploy/ffmpeg/bin.
FFMPEG_BIN=

# Optional Gemini / JXB / OpenAI-compatible providers
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TEXT_MODEL=gemini-3.1-pro-preview
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview
GEMINI_API_KEY=
JXB_BASE_URL=http://47.116.22.0:3000/v1
JXB_API_KEY=
JXB_TEXT_API_KEY=
JXB_IMAGE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_API_KEY=
